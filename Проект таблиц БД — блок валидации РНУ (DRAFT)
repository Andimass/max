## 2. `rnu_report.validation_result` — лог результатов проверок

| Поле | Тип | Обяз. | Описание |
|---|---|---|---|
| id | uuid PK | X | Идентификатор записи лога |
| check_code | varchar(10) | X | Логич. ссылка на `validation_check.code` (по дате действия) |
| job_id | uuid | X | Задание формирования |
| job_period_id | uuid |  | Период отчёта |
| person_id | uuid |  | ФЛ |
| do_id | uuid |  | Договорные отношения |
| employee_number | varchar(10) |  | Табельный номер |
| operation_id | varchar(30) |  | Ссылка на запись РНУ (`rnu_income.operation_id`) |
| income_id | uuid |  | Ссылка на строку `rnu_income` (если проверка по доходу) |
| result | enum | X | DETECTED / NOT_DETECTED (отклонение выявлено/нет) |
| severity | enum |  | ERROR / WARNING (денорм. на момент прогона) |
| error_code | varchar(4) |  | Код ошибки |
| error_text | text |  | Материализованный текст ошибки |
| recommended_action | text |  | Рекомендуемое действие |
| checked_at | timestamptz | X | Дата/время проверки |
| deviation_id | uuid |  | Наш стабильный ключ отклонения (для сверки/обратного статуса) |
| sent_to_validation | boolean | X | Признак отправки в Валидацию |
| sent_at | timestamptz |  | Когда отправлено |
| validator_request_no | varchar(50) |  | Номер заявки от Валидатора (ИВ-27.2) (сверить) |
| correction_status | enum | X | NEW / SENT / IN_PROGRESS / FIXED / REFORMED / CLOSED |
| created_at / updated_at | timestamptz | X | Аудит |

```sql
CREATE TYPE rnu_report.validation_result_kind      AS ENUM ('DETECTED','NOT_DETECTED');
CREATE TYPE rnu_report.validation_correction_status AS ENUM ('NEW','SENT','IN_PROGRESS','FIXED','REFORMED','CLOSED');

CREATE TABLE rnu_report.validation_result (
    id                   uuid PRIMARY KEY DEFAULT gen_random_uuid(),
    check_code           varchar(10) NOT NULL,                          -- → validation_check.code (по дате)
    job_id               uuid NOT NULL,
    job_period_id        uuid,
    person_id            uuid,
    do_id                uuid,
    employee_number      varchar(10),
    operation_id         varchar(30),                                   -- rnu_income.operation_id
    income_id            uuid,                                          -- rnu_income.id (если проверка по доходу)
    result               rnu_report.validation_result_kind NOT NULL,
    severity             rnu_setting.validation_severity,
    error_code           varchar(4),
    error_text           text,
    recommended_action   text,
    checked_at           timestamptz NOT NULL DEFAULT now(),
    deviation_id         uuid,                                          -- стабильный ключ отклонения
    sent_to_validation   boolean NOT NULL DEFAULT false,
    sent_at              timestamptz,
    validator_request_no varchar(50),                                   -- номер заявки Валидатора (сверить)
    correction_status    rnu_report.validation_correction_status NOT NULL DEFAULT 'NEW',
    created_at           timestamptz NOT NULL DEFAULT now(),
    updated_at           timestamptz NOT NULL DEFAULT now()
);

CREATE INDEX ix_vr_period_person ON rnu_report.validation_result (job_period_id, person_id);
CREATE INDEX ix_vr_deviation     ON rnu_report.validation_result (deviation_id);
CREATE INDEX ix_vr_to_send       ON rnu_report.validation_result (sent_to_validation, result)
                                  WHERE result = 'DETECTED';
```

