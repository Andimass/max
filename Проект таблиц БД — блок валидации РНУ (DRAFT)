## 1. `rnu_setting.validation_check` — реестр проверок

| Поле | Тип | Обяз. | Описание | Пример |
|---|---|---|---|---|
| id | bigserial PK | X | Суррогатный ключ | 1 |
| code | varchar(10) | X | Код проверки | V_001 |
| name | varchar(255) | X | Наименование | Наличие фамилии |
| check_type | enum | X | Тип: PRESENCE / FORMAT / LOGIC / CONTROL_NUMBER | PRESENCE |
| severity | enum | X | Важность: ERROR / WARNING | ERROR |
| error_code | varchar(4) |  | Код ошибки для уведомления | 12 |
| error_text_tpl | text |  | Шаблон текста ошибки (с подстановками) | База ≠ доход − вычет |
| rule | text | X | Правило/выражение проверки | base_amount = income_amount − Σdeduction |
| target_entity | varchar(20) |  | Объект проверки: PERSON_DATA / INCOME / DEDUCTION | INCOME |
| recommended_action | text |  | Рекомендуемое действие (отдаём в Валидацию) (сверить формат) | Проверить вычеты |
| start_date | date | X | Действует с | 2026-01-01 |
| end_date | date | X | Действует по | 9999-12-31 |
| status | enum | X | ACTIVE / INACTIVE | ACTIVE |
| created_at / updated_at | timestamptz | X | Аудит | now() |
| updated_by | varchar(50) |  | Кто изменил | — |

UNIQUE (code, start_date).

```sql
CREATE TYPE rnu_setting.validation_check_type   AS ENUM ('PRESENCE','FORMAT','LOGIC','CONTROL_NUMBER');
CREATE TYPE rnu_setting.validation_severity     AS ENUM ('ERROR','WARNING');
CREATE TYPE rnu_setting.validation_check_status AS ENUM ('ACTIVE','INACTIVE');

CREATE TABLE rnu_setting.validation_check (
    id                 bigserial PRIMARY KEY,
    code               varchar(10) NOT NULL,                       -- код проверки, напр. V_001
    name               varchar(255) NOT NULL,                      -- наименование
    check_type         rnu_setting.validation_check_type NOT NULL, -- наличие/формат/логика/контрольное число
    severity           rnu_setting.validation_severity   NOT NULL, -- ошибка/предупреждение
    error_code         varchar(4),                                 -- код ошибки в уведомлении (10/12/25)
    error_text_tpl     text,                                       -- шаблон текста ошибки
    rule               text NOT NULL,                              -- правило/выражение проверки
    target_entity      varchar(20),                                -- PERSON_DATA / INCOME / DEDUCTION
    recommended_action text,                                       -- рекомендуемое действие (в Валидацию)
    start_date         date NOT NULL,
    end_date           date NOT NULL DEFAULT DATE '9999-12-31',
    status             rnu_setting.validation_check_status NOT NULL DEFAULT 'ACTIVE',
    created_at         timestamptz NOT NULL DEFAULT now(),
    updated_at         timestamptz NOT NULL DEFAULT now(),
    updated_by         varchar(50),
    CONSTRAINT uq_validation_check_code_start UNIQUE (code, start_date)
);
```

