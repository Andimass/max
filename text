SELECT j.id, j.report_type, j.status,
       COALESCE(string_agg(DISTINCT x.state::text, ', '), 'нет XML') AS xml_states
FROM rnu_report.job j
LEFT JOIN rnu_report.job_period jp ON jp.job_id = j.id
LEFT JOIN rnu_report.xml_file x ON x.job_period_id = jp.id
WHERE j.status = 'DONE'
GROUP BY j.id, j.report_type, j.status
HAVING COALESCE(string_agg(DISTINCT x.state::text, ', '), '') !~ 'SEND_SUCCESS|SEND_PROCESSING'
LIMIT 10;
