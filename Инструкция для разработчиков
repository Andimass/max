                !!! другие поля в nav Info колокольчика не поддерживаются
            }
        }
        "values": {
            "параметр": "значение"
        }
    },
    "sms": {
        "version": версия смс, (передавать число, а не строку)
        "values": {
            "параметр": "значение"
        },
        "phones": ["+77777777771", "+77777777772"],
    },
    "push": {
        "version": версия пуша, (передавать число, а не строку)
        "values": {
            "параметр": "значение"
        },
        "payload": {
            "navigationInfo": "navigationInfo для перехода по пушу"
        }
    },
    "email": {
        "version": версия письма, (передавать число, а не строку)
