        ]
    },
    "sberchat": {
        "version": версия сберчата, (передавать число, а не строку)
        "values": {
            "параметр": "значение"
        },
        "link": "относительная ссылка для перехода из сберчата на платформу"
    },
    "scheduled": {
        "mode": "режим отправки уведомления",
        "time": "время отправки уведомления в формате 2025-04-05T10:00:00",
        "timeZone": "часовой пояс в формате Europe/Moscow"
    }
}
Атрибутивный состав запроса (жирным выделены обязательные поля):

Атрибут
Тип данных	Описание	Значение по умолчанию
header	Object	


id	UUID4	id уведомления, присваивается сервисом-инициатором	

createdAt	LocalDateTime	Дата и время создания уведомления	

eventType	String	Название топика Kafka у	NotificationV4

serviceId	String	Техническое название сервиса-инициатора	

componentId	String	Техническое название компонента сервиса-инициатора	
personProfileIds	Array	Массив ppid получателей уведомления	
code	String	Код уведомления	
bell	Object	Объект, содержащий данные об уведомлении для канала "колокольчик"	

version	Integer	Версия уведомления. Для новых сервисов достаточно передавать значение "0"	

image	String	Ссылка на иконку уведомления в ContentStorage	

link	String	Ссылка, по которой должен происходить редирект в платформе Пульс	

payload	Object	Объект, содержащий доп.информацию по уведомлению	


navigationInfo	Object	Объект, содержащий информацию о редиректе из уведомления в рамках мобильного приложения. Подробнее - NavigationInfo	



id	String	Идентификатор объекта, на который происходит редирект	



target	String	Идентификатор экрана МП, на который происходит навигация при нажатии на уведомление	

values	Object	Объект, содержащий перечень динамических параметров уведомления	
sms	Object	Объект, содержащий данные об уведомлении для канала "СМС"	

version	Integer	Версия уведомления. Для новых сервисов достаточно передавать значение "0"	

values	Object	Объект, содержащий перечень динамических параметров уведомления	

phones	Array	Массив номеров телефонов, на которые должна производиться рассылка СМС	
push
Object	Объект, содержащий данные об уведомлении для канала "пуш"	

version	Integer	Версия уведомления. Для новых сервисов достаточно передавать значение "0"	

values	Object	Объект, содержащий перечень динамических параметров уведомления	

payload	Object	Объект, содержащий доп.информацию по уведомлению	


navigationInfo	Object	Объект, содержащий информацию о редиректе из уведомления в рамках мобильного приложения. Подробнее - NavigationInfo	
email
Object	Объект, содержащий данные об уведомлении для канала "почта"	

version	Integer	Версия уведомления. Для новых сервисов достаточно передавать значение "0"	

values	Object	Объект, содержащий перечень динамических параметров уведомления	

emailAddresses	Array	Массив адресов электронной почты, на которые должна производиться рассылка писем. Указывается в случае, если рассылка осуществляется на внешних получателей.	

multiCompanyEmailAddresses	Object	Объект, содержащий адреса почт получателей в разрезе компаний. Актуально только для клиентов мультикомпани.	


company	Array	Массив адресов электронной почты получателей в разрезе компании. Вместо названия параметра "company" необходимо указывать код компании.	

attachments	Array	Массив ссылок (uri) на файлы в ContentStorage, которые должны быть вложены в почтовое уведомление	
sberchat

Object	Объект, содержащий данные об уведомлении для канала "СберЧат"	

version	Integer	Версия уведомления. Для новых сервисов достаточно передавать значение "0"	

values	Object	Объект, содержащий перечень динамических параметров уведомления	

link	String	Ссылка, по которой должен происходить редирект в платформе Пульс	
scheduled	Object	Объект 	

mode	Enum	
Режим отправки уведомления. Доступные значения:

IMMEDIATE - мгновенная отправка уведомления
IMMEDIATE_ACCORDING_PERSON_WORKTIME - мгновенная отправка уведомления в рамках рабочего времени получателя
SCHEDULED - отправка уведомления в заданное время
SCHEDULED_ACCORDING_PERSON_WORKTIME - отправка уведомления в заданное время в рамках рабочего времени получателя
Подробнее о режимах - Рассылка по заданному Бизнес-сервисом времени



time	LocalDateTime	Время отправки уведомления в UTC.	

timeZone	String	Часовой пояс	Europe/Moscow


