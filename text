{
"$schema": "http://json-schema.org/draft-07/schema#",
 
  "title": "DeploymentEvent",
 
  "description": "Сообщение о событии установки дистрибутива",
 
  "type": "object",
 
  "properties": {
 
    "rquid": {
 
      "description": "Уникальный ID сообщения",
 
      "type": "string"
 
    },
"timestamp": {
 
      "description": "Время события",
 
      "type": "string",
 
      "format": "date-time"
 
    },
 
    "source": {
 
      "description": "Источник установки",
 
      "type": "string"
 
    },
   "stand_type": {
 
      "description": "Тип стенда",
 
      "type": "string"
 
    },      
    
 "component_names": {
 
      "description": "Список названий элементов (устанавливаемых компонентов)",
 
      "type": "array",
 
      "items": {
 
        "type": "object",
 
        "properties": {
 
          "file_name": {
 
            "description": "Название элемента (путь до файла с расширением или папку в дистрибутиве)",
 
            "type": "string"
 
          },
          "component_type": {
 
            "description": "Тип элемента",
 
            "type": "string"
          }
 
        },
        "required": ["file_name", "component_type"]
      }
 
    },
      "nexus_url": {
 
      "description": "Ссылка на дистрибутив",
 
      "type": "string",
 
      "format": "uri"
 
    },
 
    "system_ci": {
 
      "description": "КЭ ИТ-Услуги",
 
      "type": "string"
 
    },
 
    "as_ci": {
 
      "description": "Наименование род. АС от ИТ-Услуги",
 
      "type": "string"
 
    },
 
    "resource_ci": {
 
      "description": "КЭ ТРа (для OSh - КЭ квоты)",
 
      "type": "string"
 
    },
 
    "resource_type": {
 
      "description": "Tип ТРа",
 
      "type": "string"
 
    },
 
    "cluster": {
 
      "description": "Кластер Openshift/DropApp",
 
      "type": "string",
 
      "format": "uri"
 
    },
 
    "namespace": {
 
      "description": "Неймспейс OpenShift",
 
      "type": "string"
 
    },
 
    "dns": {
 
      "description": "DNS-имя хоста",
 
      "type": "string"
 
    },
 
    "ip": {
 
      "description": "IP-адрес (массив адресов)",
 
      "type": "array",
 
      "items": {
 
        "type": "string",
 
        "format": "ipv4"
 
      }
 
    "console": {
 
      "description": "IP консоли OpenShift (тип балансировщик, в аль.связях)",
 
      "type": "string"    
      
      },
 
    "network": {
 
      "description": "СЗБ (Сеть защиты банка)",
 
      "type": "string"
 
    }
 
  },
 
  "required": [
 
    "rquid",
 
    "timestamp",
 
    "source",
 
    "stand_type",
 
    "component_names",
 
    "file_name",
 
    "nexus_url",
 
    "system_ci",
 
    "as_ci",
 
    "resource_ci",
 
    "resource_type",
 
    "cluster",
 
    "namespace"
 
  ],
 
  "additionalProperties": false
 
}
